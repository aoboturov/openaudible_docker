# Copy to .env next to docker-compose.yml. .env is git-ignored.

# REQUIRED: password for the web desktop (user name is "abc").
OA_PASSWORD=change-me-to-something-long

# Host directory for books, settings and the Audible session.
OA_DATA_DIR=./openaudible_data

# UID/GID that should own files in OA_DATA_DIR (run: id -u; id -g).
PUID=1000
PGID=1000

TZ=UTC

# Host port for the HTTPS web desktop.
OA_HTTPS_PORT=3001
