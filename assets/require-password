#!/usr/bin/with-contenv bash
# Refuse to start the web desktop without a password.
#
# The KasmVNC desktop gives whoever reaches it a terminal, the Audible session
# and write access to the library. Running it unauthenticated is only sane on a
# fully trusted network, so it has to be opted into explicitly.
#
# Set PASSWORD (or FILE__PASSWORD pointing at a secret file, handled by the
# linuxserver base image) to enable authentication. Set
# OA_ALLOW_NO_PASSWORD=true to run without one.

if [ -n "${PASSWORD:-}" ]; then
    if [ "${#PASSWORD}" -lt 8 ]; then
        echo "[require-password] WARNING: PASSWORD is shorter than 8 characters."
    fi
    exit 0
fi

if [ "${OA_ALLOW_NO_PASSWORD:-false}" = "true" ]; then
    echo "[require-password] WARNING: running WITHOUT a password because OA_ALLOW_NO_PASSWORD=true."
    echo "[require-password] WARNING: anyone who can reach this container's web port has full desktop access."
    exit 0
fi

cat >&2 <<'MSG'
[require-password] ERROR: no PASSWORD set. Refusing to start.

  Set a password for the web desktop:
      -e PASSWORD=your-long-password
  or read it from a secret file:
      -e FILE__PASSWORD=/run/secrets/openaudible_password
  or, only on a fully trusted network, run unauthenticated on purpose:
      -e OA_ALLOW_NO_PASSWORD=true

MSG

# Stop the supervisor so the container exits instead of serving an open desktop.
if [ -x /run/s6/basedir/bin/halt ]; then
    /run/s6/basedir/bin/halt
else
    kill 1
fi
exit 1
